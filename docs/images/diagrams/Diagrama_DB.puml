@startuml DBmodelo
!define Table(name,desc) class name as "desc" << (T,#FFAAAA) >>
!define primary_key(x) <b><color:red>PK: x</color></b>
!define foreign_key(x) <color:blue>FK: x</color>
!define unique(x) <color:green>UK: x</color>

skinparam linetype ortho
skinparam classAttributeIconSize 0

' ==========================================
' ENTIDADES DEL SISTEMA
' ==========================================

entity "personas" as personas {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  nombres: VARCHAR(255) NOT NULL
  apellidos: VARCHAR(255) NOT NULL
  dni: VARCHAR(50) NOT NULL <<unique>>
  telefono: VARCHAR(50) NOT NULL
  correo: VARCHAR(255) NOT NULL <<unique>>
}

entity "cuentas" as cuentas {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  usuario: VARCHAR(255) NOT NULL <<unique>>
  contrasena_hash: VARCHAR(255) NOT NULL
  persona_id: BIGINT NOT NULL <<unique>>
  fecha_creacion: TIMESTAMP
  fecha_actualizacion: TIMESTAMP
  activo: BOOLEAN DEFAULT TRUE
}

entity "operadores_municipales" as operadores_municipales {
  primary_key(id): BIGINT PRIMARY KEY
  foreign_key(cuenta_id): BIGINT
}

entity "tecnicos" as tecnicos {
  primary_key(id): BIGINT PRIMARY KEY
  foreign_key(cuenta_id): BIGINT
}

entity "ciudadanos" as ciudadanos {
  primary_key(id): BIGINT PRIMARY KEY
  foreign_key(cuenta_id): BIGINT
}

entity "ubicaciones" as ubicaciones {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  direccion: VARCHAR(500) NOT NULL
  latitud: DOUBLE PRECISION
  longitud: DOUBLE PRECISION
  distrito: VARCHAR(255)
  departamento: VARCHAR(255)
}

entity "reportes" as reportes {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  titulo: VARCHAR(255) NOT NULL
  descripcion: VARCHAR(1000) NOT NULL
  cuenta_id: BIGINT NOT NULL
  ubicacion_id: BIGINT NOT NULL
  prioridad: VARCHAR(50)
  estado: VARCHAR(50) NOT NULL
  fecha_creacion: TIMESTAMP
  fecha_actualizacion: TIMESTAMP
  comentario_resolucion: VARCHAR(1000)
  fecha_cierre: TIMESTAMP
  operador_cierre_id: BIGINT
}

entity "fotos" as fotos {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  reporte_id: BIGINT NOT NULL
  url: VARCHAR(500) NOT NULL
  tipo: VARCHAR(20) NOT NULL
  descripcion: VARCHAR(255)
  fecha_carga: TIMESTAMP NOT NULL
  --
  **Constraint**
  CHECK (tipo IN ('INICIAL','FINAL'))
}

entity "asignaciones" as asignaciones {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  reporte_id: BIGINT NOT NULL
  operador_id: BIGINT NOT NULL
  tecnico_id: BIGINT
  fecha_asignacion: TIMESTAMP
  fecha_cierre: TIMESTAMP
}

entity "historial_estados" as historial_estados {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  reporte_id: BIGINT NOT NULL
  estado_anterior: VARCHAR(50)
  estado_nuevo: VARCHAR(50) NOT NULL
  fecha_cambio: TIMESTAMP NOT NULL
}

entity "token_notificaciones" as token_notificaciones {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  cuenta_id: BIGINT NOT NULL <<unique>>
  token: VARCHAR(512) NOT NULL
}

entity "mensaje_notificaciones" as mensaje_notificaciones {
  primary_key(id): BIGSERIAL PRIMARY KEY
  --
  estado: VARCHAR(50) NOT NULL <<unique>>
  mensaje: VARCHAR(500) NOT NULL
}

' ==========================================
' RELACIONES (con cardinalidad)
' ==========================================

' ||--|| : Relación 1:1 (uno a uno - exactamente)
personas ||--|| cuentas : "tiene"

' ||--o| : Relación 0:1 (cero o uno) - HERENCIA JOINED
' Tabla padre (cuentas) se relaciona con tablas hijas (operadores, técnicos, ciudadanos)
' Cada tabla hija tiene su propia tabla pero comparte el PK como FK hacia cuentas
' Esto evita duplicar campos de autenticación en 3 tablas diferentes
cuentas ||--o| operadores_municipales : "herencia"
cuentas ||--o| tecnicos : "herencia"
cuentas ||--o| ciudadanos : "herencia"

' ||--o{ : Relación 0:N (cero o muchos) - un ciudadano PUEDE crear varios reportes
ciudadanos ||--o{ reportes : "crea"

' ||--o{ : un registro de ubicación PUEDE tener varios reportes
ubicaciones ||--o{ reportes : "tiene"

' ||--o{ : un reporte PUEDE tener múltiples fotos (inicial y final)
reportes ||--o{ fotos : "contiene"

' ||--o{ : un operador municipal PUEDE rechazar múltiples reportes
operadores_municipales ||--o{ reportes : "rechaza"

' ||--|| : un reporte tiene exactamente 1 asignación (a 1 técnico únicamente)
reportes ||--|| asignaciones : "tiene"

' ||--o{ : un técnico PUEDE estar asignado a (cero o muchos) múltiples reportes
tecnicos ||--o{ asignaciones : "asignado a"

' ||--o{ : un operador municipal PUEDE gestionar múltiples asignaciones
operadores_municipales ||--o{ asignaciones : "gestiona"

' ||--o{ : un reporte PUEDE tener múltiples cambios de estado registrados
reportes ||--o{ historial_estados : "tiene"

' ||--o| : una cuenta tiene 0 ó 1 token de notificaciones (FCM de Firebase)
cuentas ||--o| token_notificaciones : "tiene"

' ||--o{ : un estado predefinido PUEDE estar asociado a múltiples reportes
mensaje_notificaciones ||--o{ reportes : "para estado"

@enduml
