@startuml
title CU-06 · Validar reportes ciudadanos
skinparam maxMessageSize 160
autonumber

actor "Operador de Oficina Municipal" as Operador
boundary "Vista 01 Cola de reportes\n(HomeScreenOperador)" as V1
boundary "Vista 02 Gestion\n(GestionReportesScreen)" as V2
control "OperadorReportesController" as OCtrl
participant "ServicioReportes" as SvcR
database "LocalStore\n(reportes.json · historial.json)" as DB

group Flujo Principal y Escenario 1: Carga de la cola
    Operador -> V1: Accede a la Cola de reportes
    V1 -> OCtrl: cargar()\n[addPostFrameCallback en initState]
    OCtrl -> SvcR: obtenerTodos()
    SvcR -> DB: retorna todos los reportes\nordena desc por fechaActualizacion
    DB --> SvcR: List<ReporteResponse>
    SvcR --> OCtrl: lista completa
    OCtrl --> V1: RxList + contadores reactivos\n(pendientes · enRevision · finalizados)

    alt Hay reportes
        V1 --> Operador: Muestra cola con chips de filtro y 3 contadores
    else Sin reportes (Escenario 1)
        V1 --> Operador: Muestra lista vacia
    end
end

group Flujo Principal y Escenario 2: Ver detalle y decidir
    Operador -> V1: clic en un reporte (estado PENDIENTE)
    V1 -> V2: Get.to(GestionReportesScreen(reporteId))
    V2 -> SvcR: obtenerFotos(reporteId, tipo: INICIAL)
    SvcR -> DB: fotosDe(reporteId, INICIAL)
    DB --> V2: List<Foto> INICIAL
    V2 -> SvcR: obtenerFotos(reporteId, tipo: FINAL)
    SvcR -> DB: fotosDe(reporteId, FINAL)
    DB --> V2: List<Foto> FINAL
    V2 --> Operador: muestra detalle + MapPinView(lat, lng)\n+ FotosStrip INICIAL

    alt Aceptar reporte (Flujo Principal)
        Operador -> V2: clic "Aceptar reporte"
        V2 -> OCtrl: aceptar(reporteId)
        OCtrl -> SvcR: aceptarReporte(id)
        SvcR -> DB: copyWith(estado = REVISION\nfechaActualizacion = now())
        SvcR -> DB: registrarCambioEstado\n(PENDIENTE -> REVISION)
        DB --> SvcR: ReporteResponse actualizado
        SvcR --> OCtrl: ReporteResponse
        OCtrl -> SvcR: obtenerTodos() [recarga lista]
        SvcR --> OCtrl: lista actualizada
        OCtrl --> V2: Obx reacciona\nAppToast.success "Ahora en Revision"
        V2 --> Operador: avisa que falta asignar tecnico (CU-07)
    else Rechazar reporte (Escenario 2)
        Operador -> V2: clic "Rechazar reporte"
        V2 --> Operador: muestra AlertDialog con campo de motivo
        Operador -> V2: ingresa motivo y clic "Confirmar rechazo"
        V2 -> OCtrl: rechazar(reporteId, motivo)
        OCtrl -> SvcR: rechazarReporte(id, motivo)
        SvcR -> DB: copyWith(estado = RECHAZADO\ncomentarioResolucion = motivo\nfechaCierre = now())
        SvcR -> DB: registrarCambioEstado\n(PENDIENTE -> RECHAZADO)
        DB --> SvcR: ReporteResponse actualizado
        SvcR --> OCtrl: ReporteResponse
        OCtrl -> SvcR: obtenerTodos() [recarga lista]
        SvcR --> OCtrl: lista actualizada
        V2 -> V2: AppToast.success\nGet.until(route == /operador)
        V2 --> Operador: Redirige a Vista 01 Cola de reportes
    end
end
@enduml
