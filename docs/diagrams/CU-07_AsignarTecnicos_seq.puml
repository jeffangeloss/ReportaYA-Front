@startuml
title CU-07 · Asignar tecnicos a reportes en revision
skinparam maxMessageSize 160
autonumber

actor "Operador de Oficina Municipal" as Operador
boundary "Vista 01 Cola de reportes\n(HomeScreenOperador)" as V1
boundary "Vista 02 Gestion\n(GestionReportesScreen)" as V2
control "OperadorReportesController" as OCtrl
control "TecnicosController" as TCtrl
participant "ServicioReportes" as SvcR
participant "ServicioTecnicos" as SvcT
database "LocalStore\n(reportes.json · cuentas.json)" as DB

group Seleccion del reporte en Revision
    Operador -> V1: clic en un reporte (estado REVISION)
    V1 -> V2: Get.to(GestionReportesScreen(reporteId))
    V2 -> SvcR: obtenerFotos(reporteId, tipo: INICIAL)
    SvcR -> DB: fotosDe(reporteId, INICIAL)
    DB --> V2: List<Foto> INICIAL
    V2 --> Operador: muestra detalle + MapPinView(lat, lng)\ntecnico asignado o "Sin tecnico asignado"
end

group Flujo Principal y Escenario 1: Asignacion del tecnico
    Operador -> V2: clic "Asignar Tecnico" (o "Reasignar Tecnico")
    V2 -> TCtrl: cargar()
    TCtrl -> SvcT: obtenerDisponibles()
    SvcT -> DB: filtra cuentas\n(tipoCuenta = TECNICO · activo = true)
    DB --> SvcT: List<TecnicoResponse>
    SvcT --> TCtrl: tecnicos activos
    TCtrl --> V2: Obx actualiza lista en BottomSheet

    alt Hay tecnicos disponibles
        V2 --> Operador: muestra BottomSheet con lista de tecnicos
        Operador -> V2: tap en un tecnico de la lista
        V2 -> OCtrl: asignar(reporteId, TecnicoResponse)
        OCtrl -> SvcR: asignarTecnico(id, tecnico)
        SvcR -> DB: copyWith(tecnicoAsignadoId = tecnico.id\ntecnicoNombre = tecnico.nombreCompleto\nfechaActualizacion = now())
        note right of DB: El estado se mantiene en REVISION
        DB --> SvcR: ReporteResponse con tecnico asignado
        SvcR --> OCtrl: ReporteResponse actualizado
        OCtrl -> SvcR: obtenerTodos() [recarga lista]
        SvcR --> OCtrl: lista actualizada
        OCtrl --> V2: Obx reacciona\nAppToast.success con nombre del tecnico
        V2 --> Operador: confirma la asignacion
    else Sin tecnicos disponibles (Escenario 1)
        V2 --> Operador: muestra "No hay tecnicos disponibles."
    end
end
@enduml
