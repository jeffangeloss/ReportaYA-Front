@startuml
title CU-01 · Iniciar sesion
skinparam maxMessageSize 160
autonumber
actor Usuario
boundary "Vista 01 Login" as V1
boundary "Vista 02 Inicio" as V2
boundary "Vista 01 Cola de reportes" as VC
boundary "Vista 01 Mis asignaciones" as VM
control "Backend (Ruby)" as Backend
database "Base de Datos (SQLite)" as DB

group Flujo Principal y Escenarios alternativos
    Usuario -> V1: Ingresa usuario y contrasena, clic "Iniciar sesion"
    V1 -> Backend: Solicita autenticacion (credenciales)
    Backend -> DB: Query(SELECT cuenta WHERE usuario)
    DB --> Backend: Retorna datos de la cuenta

    alt Credenciales validas
        Backend --> V1: Retorna token, datos de usuario y rol
        alt Rol Ciudadano
            V1 -> V2: Redirige a la vista Inicio
            V2 --> Usuario: Muestra la vista Inicio
        else Rol Operador de Oficina Municipal
            V1 -> VC: Redirige a la vista Cola de reportes
            VC --> Usuario: Muestra la cola de reportes
        else Rol Tecnico de Campo Municipal
            V1 -> VM: Redirige a la vista Mis asignaciones
            VM --> Usuario: Muestra las asignaciones
        end
    else Credenciales incorrectas (Escenario 1)
        Backend --> V1: Notifica credenciales incorrectas
        V1 --> Usuario: Muestra error e invita a reintentar
    else Usuario no registrado (Escenario 2)
        Backend --> V1: Notifica que el usuario no existe
        V1 --> Usuario: Muestra error y sugiere registrarse
    end
end
@enduml
