@startuml
title CU-04 · Reportar incidencia urbana
skinparam maxMessageSize 160
autonumber

actor Ciudadano
boundary "Vista 02 Inicio\n(InicioScreen)" as V2
boundary "Vista 04 Reportar\n(ReportScreen)" as V4
boundary "Vista 03 Mis Reportes\n(MisReportesScreen)" as V3
control "ReportesController" as RCtrl
control "TabsController" as TCtrl
participant "ServicioReportes" as SvcR
participant "ServicioGeocoding\n(Nominatim OSM)" as SvcGeo
database "LocalStore\n(reportes.json · fotos.json\nhistorial.json)" as DB

group Flujo Principal y Escenario 1
    Ciudadano -> V2: clic en "Reportar Incidencia"
    V2 -> TCtrl: go(2)
    TCtrl --> V4: activa indice 2 del IndexedStack

    Ciudadano -> V4: tap en MapPickerView\n(selecciona ubicacion en el mapa OSM)
    V4 -> SvcGeo: obtenerDireccion(lat, lng)
    SvcGeo -> SvcGeo: HTTP GET Nominatim\n(accept-language: es · timeout 6s)
    SvcGeo --> V4: DireccionCompleta\n(calle, distrito, ciudad)
    V4 --> Ciudadano: muestra la direccion obtenida bajo el mapa

    Ciudadano -> V4: ingresa titulo y descripcion\nselecciona tipo de problema\nagrega fotos (contador 0-5)
    Ciudadano -> V4: clic "Enviar reporte"
    V4 -> V4: valida titulo y descripcion no vacios\nvalida que se haya seleccionado ubicacion

    alt Datos validos
        V4 -> SvcR: crearReporte(CrearReporteRequest, urlsFotos)
        SvcR -> DB: agrega ReporteResponse\n(estado = PENDIENTE · id autoincrement)
        SvcR -> DB: agrega Fotos\n(tipo = INICIAL · por cada url)
        SvcR -> DB: registrarCambioEstado\n(null -> PENDIENTE)
        DB --> SvcR: nuevo id del reporte
        SvcR --> V4: ReporteResponse creado
        V4 -> RCtrl: cargarReportes(cuentaId)
        RCtrl -> SvcR: obtenerReportesPorCuenta(cuentaId)
        SvcR -> DB: filtra por cuentaId\nordena desc por fechaCreacion
        DB --> RCtrl: List<ReporteResponse>
        RCtrl --> V4: RxList actualizada
        V4 -> V4: AppToast.success · _reset() del formulario\nTabsController.go(3)
        V4 --> Ciudadano: Redirige a Vista 03 Mis Reportes
    else Datos invalidos o incompletos (Escenario 1)
        V4 --> Ciudadano: AppToast.error con el motivo
    end
end
@enduml
